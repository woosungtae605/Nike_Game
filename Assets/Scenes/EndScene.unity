  titleText: "\uBAA8\uB4E0 \uC52C\uC744 \uD074\uB9AC\uC5B4 \uD588\uC2B5\uB2C8\uB2E4"
  subText: "\\uBC84\\uD2BC\\uC744 \\uB20C\\uB7EC \\uBA54\\uC778\\uC73C\\uB85C \\uB3CC\\uC544\\uAC11\\uB2C8\\uB2E4."
  scrollText: "\uB0E5\uCF00\n\n\uD50C\uB808\uC774\uD574\uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4.\n\n\uB2F9\uC2E0\uC758
    \uC2B9\uB9AC\uB85C\n\uBAA8\uB4E0 \uC804\uD22C\uAC00 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4.\n\n\uB0E5\uCF00\uB4E4\uC740
